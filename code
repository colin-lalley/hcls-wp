          style={{ backgroundColor: COLORS.primaryGreen }}
        >
          {loading ? <Loader2 className="animate-spin" /> : <Sparkles size={18} />}
          {loading ? 'Building Strategy...' : '✨ Generate My Strategy'}
        </button>

        {error && <p className="mt-4 text-center text-xs text-red-500">{error}</p>}

        {plan && (
          <div className="mt-8 p-6 rounded-2xl bg-darkBlue text-white animate-in fade-in slide-in-from-bottom-4 duration-500">
            <h4 className="text-xs font-bold uppercase tracking-widest text-primaryGreen mb-4">Your Custom Action Plan</h4>
            <div className="prose prose-invert prose-sm max-w-none text-lightGray whitespace-pre-line leading-relaxed">
              {plan}
            </div>
            <button 
              onClick={() => setPlan(null)}
              className="mt-6 text-[10px] uppercase font-bold flex items-center gap-1 hover:text-primaryGreen transition-colors"
            >
              <RefreshCw size={12} /> Start Over
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

// --- SUB-COMPONENT: EXPERT CHAT (✨ GEMINI POWERED) ---
const ExpertChat = ({ isOpen, setIsOpen }) => {
  const [input, setInput] = useState('');
  const [messages, setMessages] = useState([
    { role: 'assistant', text: 'Hi! I\'m your ✨ AI Risk Expert. Ask me anything about HLS risk, regulatory compliance, or insurance from the whitepaper.' }
  ]);
  const [isTyping, setIsTyping] = useState(false);
  const chatEndRef = useRef(null);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, isTyping]);

  const handleSend = async () => {
    if (!input.trim() || isTyping) return;
    
    const userMsg = input;
    setInput('');
    setMessages(prev => [...prev, { role: 'user', text: userMsg }]);
    setIsTyping(true);

    try {
      const systemInstruction = `You are a helpful HLS Insurance and Risk Assistant based on the provided whitepaper text. Use only the information found in the document to answer. If the answer is not in the text, politely say you don't have that information but recommend speaking with a Vouch advisor. Keep responses professional, clear, and actionable.`;
      const result = await callGemini(userMsg, systemInstruction);
      setMessages(prev => [...prev, { role: 'assistant', text: result }]);
    } catch (err) {
      setMessages(prev => [...prev, { role: 'assistant', text: "I'm having trouble connecting to my knowledge base. Please try asking again in a moment." }]);
    } finally {
      setIsTyping(false);
    }
  };

  return (
    <div className="fixed bottom-6 right-6 z-[60] flex flex-col items-end">
      {isOpen && (
        <div className="mb-4 w-80 sm:w-96 h-[500px] bg-white rounded-[32px] border border-lightGray shadow-2xl flex flex-col overflow-hidden animate-in zoom-in-95 fade-in slide-in-from-bottom-12 duration-300 origin-bottom-right">
          <div className="bg-darkBlue p-4 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-8 h-8 rounded-full bg-primaryGreen flex items-center justify-center text-darkBlue">
                <Sparkles size={16} />
              </div>
              <div>
                <h4 className="text-white text-xs font-bold leading-none">✨ AI Blueprint Expert</h4>
                <p className="text-[10px] text-primaryGreen mt-1">Powered by Gemini</p>
              </div>
            </div>
            <button onClick={() => setIsOpen(false)} className="text-white/60 hover:text-white"><X size={20}/></button>
          </div>

          <div className="flex-1 overflow-y-auto p-4 space-y-4">
            {messages.map((m, i) => (
              <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div className={`max-w-[85%] p-3 rounded-2xl text-xs leading-relaxed ${
                  m.role === 'user' 
                    ? 'bg-primaryGreen text-darkBlue font-medium rounded-tr-none' 
                    : 'bg-lightTaupe border border-lightGray rounded-tl-none'
                }`}>
                  {m.text}
                </div>
              </div>
            ))}
            {isTyping && (
              <div className="flex justify-start">
                <div className="bg-lightTaupe border border-lightGray p-3 rounded-2xl rounded-tl-none flex gap-1">
                  <div className="w-1.5 h-1.5 bg-darkGray rounded-full animate-bounce"></div>
                  <div className="w-1.5 h-1.5 bg-darkGray rounded-full animate-bounce [animation-delay:0.2s]"></div>
                  <div className="w-1.5 h-1.5 bg-darkGray rounded-full animate-bounce [animation-delay:0.4s]"></div>
                </div>
              </div>
            )}
            <div ref={chatEndRef} />
          </div>

          <div className="p-4 bg-lightTaupe border-t border-lightGray flex gap-2">
            <input 
              type="text" 
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && handleSend()}
              placeholder="Ask about a specific risk..."
              className="flex-1 bg-white p-3 rounded-xl border border-lightGray text-xs outline-none focus:ring-2 focus:ring-primaryGreen"
            />
            <button 
              onClick={handleSend}
              className="p-3 rounded-xl bg-darkBlue text-white transition-transform hover:scale-110 active:scale-95"
            >
              <Send size={16} />
            </button>
          </div>
        </div>
      )}

      <button 
        onClick={() => setIsOpen(!isOpen)}
        className="w-16 h-16 rounded-full bg-darkBlue text-white shadow-2xl flex items-center justify-center transition-all hover:scale-110 active:scale-95 group relative"
      >
        <div className="absolute inset-0 rounded-full bg-primaryGreen blur-lg opacity-20 group-hover:opacity-40 transition-opacity"></div>
        {isOpen ? <X size={24} /> : <Sparkles size={24} />}
      </button>
    </div>
  );
};

